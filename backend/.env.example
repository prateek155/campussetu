# backend/.env.example — Copy this to .env and fill in values

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Firebase Admin SDK ───────────────────────────────────
# Path to your downloaded service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ─── Password reset email delivery (Resend) ────────────────────────────────
# Use a Resend API key and a sender address verified in your Resend account.
RESEND_API_KEY=re_your_api_key
PASSWORD_RESET_FROM_EMAIL=CampusSetu <noreply@example.com>

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ─── Tshare Settings ──────────────────────────────────────
TSHARE_CODE_LENGTH=4
TSHARE_EXPIRY_HOURS=24
